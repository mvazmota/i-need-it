# Where the SQLite database lives. The directory is created automatically.
DATABASE_PATH=./data/ineedit.db

# Optional single-user login. Leave APP_PASSWORD empty to disable the login screen
# (for example when running only on a private VPN). If APP_USERNAME is set, the
# login screen asks for both fields.
APP_USERNAME=
APP_PASSWORD=
# Random string used to sign the session cookie. Changing it logs everyone out.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Set to true when the app is served over HTTPS (required for Secure cookies).
COOKIE_SECURE=false

# Currency used when a shop does not expose one.
DEFAULT_CURRENCY=EUR

# Scraper behaviour.
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
SCRAPER_TIMEOUT_MS=15000

# Background worker. The worker runs forever and checks each item on its own
# interval. The cron expression only controls how often it looks for due items.
CHECK_CRON=*/15 * * * *
CHECK_ON_START=true
# Optional IANA timezone for the cron schedule, e.g. Europe/Lisbon.
TZ=Europe/Lisbon

# Optional push notifications through ntfy (https://ntfy.sh or self-hosted).
# Leave NTFY_TOPIC empty to disable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only needed for a protected/self-hosted ntfy server.
NTFY_TOKEN=
