[Unit]
Description=ineedit price worker
After=network-online.target ineedit-web.service
Wants=network-online.target
Requires=ineedit-web.service

[Service]
Type=simple
User=martin
WorkingDirectory=/home/martin/ineedit
EnvironmentFile=/home/martin/ineedit/.env
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
